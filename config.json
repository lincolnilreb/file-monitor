// File Monitor configuration
// ---------------------------------------------------------------------------
// check_interval_seconds:
//   Positive integer. How often the monitor scans folders.
//   Examples:
//     10  = every 10 seconds, useful for local testing
//     300 = every 5 minutes, typical production setting
//
// aggregation_window_seconds:
//   Non-negative integer. After the first ready feed is detected, wait this
//   many seconds and collect other ready feeds into the same notification batch.
//   Recommended default: 3.
//
// business_date:
//   "AUTO"       = calculate the business date from today's date and date_rule
//   "YYYY-MM-DD" = use a manual business date, for example "2026-07-31"
//
// date_rule:
//   Used only when business_date is "AUTO".
//   "LAST_DAY_PREVIOUS_MONTH":
//     Use the final calendar day of the previous month.
//     Example: if today is 2026-08-05, business date is 2026-07-31.
//   "SAME_DAY_PREVIOUS_MONTH":
//     Use the same day number in the previous month.
//     If the previous month is shorter, use its final day.
//     Example: 2026-03-31 becomes 2026-02-28.
//
// feeds:
//   List of files to monitor. Dashboard order follows this list order.
//   Each feed requires:
//     name     = unique operator-friendly feed name
//     source   = source system or folder label shown on the dashboard
//     path     = folder containing the inbound file; date tokens are supported
//                Use absolute paths for production.
//                Windows UNC example: "\\server\\share\\feed"
//     filename = exact filename or filename template with date tokens
//
// path and filename date tokens:
//   {yyyy}       -> 2026
//   {yy}         -> 26
//   {mm}         -> 07
//   {dd}         -> 31
//   {yyyymm}     -> 202607
//   {yyyymmdd}   -> 20260731
//   {yyyy-mm-dd} -> 2026-07-31
//   {yyyy_mm_dd} -> 2026_07_31
//
// path examples when business_date is 2026-07-31:
//   "/feeds/{yyyymm}"               -> /feeds/202607
//   "/feeds/{yyyy}/{mm}"            -> /feeds/2026/07
//   "\\server\\feed\\{yyyymmdd}"    -> \\server\\feed\\20260731
//
// filename examples when business_date is 2026-07-31:
//   "payment_recon.txt"              -> payment_recon.txt
//   "customer_{yyyymmdd}.csv"        -> customer_20260731.csv
//   "{yyyy}.{mm}_customer_daily.txt" -> 2026.07_customer_daily.txt
//   "orders_{yyyy-mm-dd}.xlsx"       -> orders_2026-07-31.xlsx
//   "positions_{yyyy_mm_dd}.txt"     -> positions_2026_07_31.txt
// ---------------------------------------------------------------------------
{
  "check_interval_seconds": 10,
  "aggregation_window_seconds": 3,
  "business_date": "AUTO",
  "date_rule": "LAST_DAY_PREVIOUS_MONTH",
  "feeds": [
    {
      "name": "Customer Daily TXT",
